#param has_beta
#param has_decay
#param has_gate_projections
#param qwen_gate
#param sigmoid_beta
#use .getByOffset .setByOffset

fn gdn_params_softplus(x: f32) -> f32 {
  if (x > 0.0) {
    return x + log(1.0 + exp(-x));
  }
  return log(1.0 + exp(x));
}

fn gdn_params_sigmoid(x: f32) -> f32 {
  if (x > 0.0) {
    return 1.0 / (1.0 + exp(-x));
  }
  let e = exp(x);
  return e / (1.0 + e);
}

$MAIN {
  let index = global_idx;
  if (index >= uniforms.total_tokens * uniforms.num_heads_v) {
    return;
  }
  let value_head = index % uniforms.num_heads_v;
  var gate = 0.0;
#if has_decay
#if has_gate_projections
  let projection_offset = (index / uniforms.num_heads_v) * (2u * uniforms.num_heads_v) + value_head;
  gate = f32(gate_projections.getByOffset(projection_offset));
#else
  gate = decay.getByOffset(index);
#endif
#if qwen_gate
  gate = -exp(a_log.getByOffset(value_head)) * gdn_params_softplus(gate + dt_bias.getByOffset(value_head));
#endif
#endif
  parameters.setByOffset(index * 2u, gate);

  var beta_value = 1.0;
#if has_beta
#if has_gate_projections
  beta_value = f32(gate_projections.getByOffset(projection_offset + uniforms.num_heads_v));
#else
  beta_value = beta.getByOffset(index);
#endif
#if sigmoid_beta
  beta_value = gdn_params_sigmoid(beta_value);
#endif
#endif
  parameters.setByOffset(index * 2u + 1u, beta_value);
}
